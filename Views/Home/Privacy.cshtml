@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold text-dark">System Dashboard</h1>
        <p class="text-muted">Real-time connection diagnostics</p>
    </div>
    
    <div class="d-flex align-items-center gap-2">
        <!-- Status Badge -->
        <span class="badge bg-success px-3 py-2 rounded-pill">
            <i class="fa-solid fa-circle-check me-2"></i>System Online
        </span>

        <!-- Logout Button -->
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-danger btn-sm fw-bold">
                <i class="fa-solid fa-power-off me-2"></i>Disconnect
            </button>
        </form>
    </div>
</div>

<div class="row g-4">
    <!-- Status Card -->
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 5px solid #28a745;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-uppercase text-muted small fw-bold">OAuth Status</h6>
                        <h3 class="fw-bold text-success">Active</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 p-2 rounded">
                        <i class="fa-solid fa-plug text-success fa-xl"></i>
                    </div>
                </div>
                <p class="mt-3 mb-0 small text-muted">
                    Token refresh automation is running.
                </p>
            </div>
        </div>
    </div>

    <!-- API Test Card -->
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 5px solid #FFB500;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-uppercase text-muted small fw-bold">API Connectivity</h6>
                        <h3 class="fw-bold" style="color: #351C15;">Shipments</h3>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-2 rounded">
                        <i class="fa-solid fa-truck-fast text-warning fa-xl"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-controller="UpsProxy" asp-action="GetShipments" class="btn btn-sm w-100 fw-bold" style="background-color: #FFB500; color: #351C15;">
                        Test Fetch Data
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Debug Card -->
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm" style="border-left: 5px solid #6c757d;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="text-uppercase text-muted small fw-bold">Diagnostics</h6>
                        <h3 class="fw-bold text-dark">Tokens</h3>
                    </div>
                    <div class="bg-secondary bg-opacity-10 p-2 rounded">
                        <i class="fa-solid fa-key text-secondary fa-xl"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-controller="UpsProxy" asp-action="Me" class="btn btn-outline-secondary btn-sm w-100">
                        Inspect Headers
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mt-4">
    <div class="card-header bg-white py-3">
        <h6 class="fw-bold mb-0"><i class="fa-solid fa-terminal me-2 text-muted"></i>Integration Logs</h6>
    </div>
    <div class="card-body bg-light">
        <code class="text-muted">
            > Initializing UPS Service... OK<br/>
            > Loading Client ID... wArgb***<br/>
            > Configuring Callback: /auth/callback... OK<br/>
            > Ready for requests.
        </code>
    </div>
</div>